{
  "name": "rebate-pool-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/export.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=./node_modules/.cache/playwright tsx tests/browser.ts",
    "check:live": "tsx scripts/check-live.ts"
  },
  "dependencies": {
    "@wagmi/core": "2.22.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "playwright": "1.55.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  },
  "overrides": { "playwright-core": "1.55.1" }
}
